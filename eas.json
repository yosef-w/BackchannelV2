{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "SENTRY_ORG": "backchannel-f6",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "yosefwolday@yahoo.com",
        "ascAppId": "6762495044",
        "appleTeamId": "ZWFR8LC25W"
      }
    }
  }
}