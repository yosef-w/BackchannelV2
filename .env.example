# ─── Environment variable template ───────────────────────────────────────────
# Copy this file to .env.development / .env.test / .env.production and fill in
# the real values. Never commit the actual .env.* files to git.

# Backchannel API base URL (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=

# Mixpanel project token (https://mixpanel.com/settings/project)
# Use a separate project token per environment so test events don't pollute
# production dashboards.
EXPO_PUBLIC_MIXPANEL_TOKEN=

# RevenueCat API keys (https://app.revenuecat.com)
# Use test_ prefixed keys for dev/test, live keys for production.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Google Places API key (https://console.cloud.google.com)
# Used by the address autocomplete in the profile editor. Restrict the key in
# GCP to: (1) the Places API (and Places API New if enabled), and (2) your
# iOS bundle ID + Android package/SHA-1 fingerprint, so a leaked key cannot be
# abused. Session tokens are used to keep billing per-session, not per-keystroke.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Sentry crash reporting (https://sentry.io — project settings → Client Keys)
# Leave empty to disable; the app no-ops gracefully without it (lib/sentry.ts).
EXPO_PUBLIC_SENTRY_DSN=
